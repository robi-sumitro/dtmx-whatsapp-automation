{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "watchPatterns": [
      "src/**",
      "web/**",
      "prisma/**",
      "package.json",
      "package-lock.json",
      "railpack.json",
      "railway.json",
      "Procfile",
      ".npmrc"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}