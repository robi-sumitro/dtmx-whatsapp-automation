# ===== DtmX WA — Environment =====
PORT=3001

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://dtmx:dtmx@localhost:5432/dtmx_wa

# ===== WhatsApp (WA Cloud API) =====
# Handshake verification token (sembarang kata rahasia; isi identik di Webhooks Meta).
WA_VERIFY_TOKEN=change-me-verify-token
# App secret utk verifikasi signature webhook X-Hub-Signature-256.
WA_APP_SECRET=change-me-app-secret
# System user access token (permanent) dari Meta Business Suite.
WA_API_TOKEN=change-me-api-token
# Kunci enkripsi token (minimal 32 karakter acak) utk CryptoService.
APP_ENCKEY=change-me-to-a-long-random-32-char-key

# ===== Auth (JWT) =====
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=15m

# AI (opsional untuk auto-reply)
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ===== SPA Auth =====
# Kredensial login untuk panel web (admin).
AUTH_EMAIL=admin@dtmx.app
AUTH_PASSWORD=change-me-admin-password
